            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ConcurrentHashMap

int count = (vars.get(&quot;patientData_matchNr&quot;) ?: &quot;0&quot;) as int
if (count == 0) {
    log.warn(&quot;No waiting patients found&quot;)
    return
}

// Thread Group name (important for isolation)
def tgName = ctx.getThreadGroup().getName()

// Property key per TG
def propKey = &quot;PATIENT_POOL_&quot; + tgName

// Create thread-safe map if not exists
def pool = props.get(propKey)
if (pool == null) {
    synchronized(this) {
        pool = props.get(propKey)
        if (pool == null) {
            pool = new ConcurrentHashMap()
            props.put(propKey, pool)
        }
    }
}

def slurper = new JsonSlurper()
boolean selected = false

for (int i = 1; i &lt;= count; i++) {

    def patientJson = vars.get(&quot;patientData_&quot; + i)
    if (!patientJson) continue

    def obj = slurper.parseText(patientJson)

    def uin = obj?.uin
    def firstName = obj?.firstName

    // ✅ FILTER only PATIENT-PT*
    if (!uin || !firstName?.startsWith(&quot;PATIENT-PT&quot;))
        continue

    // ✅ Atomic check
    if (pool.putIfAbsent(uin, true) == null) {

        vars.put(&quot;uin&quot;, uin)
        vars.put(&quot;mrNo&quot;, obj?.mrNo ?: &quot;&quot;)
        vars.put(&quot;pin&quot;, obj?.pin ?: &quot;&quot;)
        vars.put(&quot;oid&quot;, obj?.oid ?: &quot;&quot;)
        vars.put(&quot;firstName&quot;, firstName)

        log.info(&quot;TG: &quot; + tgName + &quot; Selected UIN: &quot; + uin)

        selected = true
        break
    }
}

if (!selected) {
    log.warn(&quot;TG: &quot; + tgName + &quot; No unused PATIENT-PT available&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ConcurrentHashMap

// Total patients extracted
int count = (vars.get(&quot;patientData_matchNr&quot;) ?: &quot;0&quot;) as int
if (count == 0) {
    log.warn(&quot;No waiting patients found&quot;)
    return
}

// Get lastUIN from UDV
long lastUinLimit = (vars.get(&quot;lastUIN&quot;) ?: &quot;0&quot;) as long

// Identify Thread Group
def tgName = ctx.getThreadGroup().getName()
def propKey = &quot;PATIENT_POOL_&quot; + tgName

// Create thread-safe pool per TG
def pool = props.get(propKey)

if (pool == null) {
    synchronized(this) {
        pool = props.get(propKey)
        if (pool == null) {
            pool = new ConcurrentHashMap()
            props.put(propKey, pool)
        }
    }
}

def slurper = new JsonSlurper()
boolean selected = false

for (int i = 1; i &lt;= count; i++) {

    def patientJson = vars.get(&quot;patientData_&quot; + i)
    if (!patientJson) continue

    def obj = slurper.parseText(patientJson)

    def uin = obj?.uin
    def firstName = obj?.firstName

    if (!uin || !firstName?.startsWith(&quot;PATIENT-PT&quot;))
        continue

    long currentUin = uin as long

    // 🔥 Skip already completed range
    if (currentUin &lt;= lastUinLimit)
        continue

    // 🔥 Thread-safe uniqueness inside TG
    if (pool.putIfAbsent(uin, true) == null) {

        vars.put(&quot;uin&quot;, uin)
        vars.put(&quot;mrNo&quot;, obj?.mrNo ?: &quot;&quot;)
        vars.put(&quot;pin&quot;, obj?.pin ?: &quot;&quot;)
        vars.put(&quot;oid&quot;, obj?.oid ?: &quot;&quot;)
        vars.put(&quot;firstName&quot;, firstName)

        log.info(&quot;TG: &quot; + tgName + 
                 &quot; Selected UIN: &quot; + uin + 
                 &quot; (greater than lastUIN: &quot; + lastUinLimit + &quot;)&quot;)

        selected = true
        break
    }
}

if (!selected) {
    log.warn(&quot;TG: &quot; + tgName + 
             &quot; No eligible patient found above lastUIN: &quot; + lastUinLimit)
}</stringProp>
