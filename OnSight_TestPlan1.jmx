              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor" enabled="false">
                <stringProp name="JSONPostProcessor.referenceNames">firstName;oid;pin;uin;mrNo</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.waitingPatients[*].firstName;$.waitingPatients[*].oid; $.waitingPatients[*].pin;$.waitingPatients[*].uin; $.waitingPatients[*].mrNo</stringProp>
