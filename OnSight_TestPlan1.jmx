                <stringProp name="JSONPostProcessor.referenceNames">patientData</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.waitingPatients[*]</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
