            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ConcurrentHashMap

int count = (vars.get(&quot;patientData_matchNr&quot;) ?: &quot;0&quot;) as int

if (count == 0) {
    log.warn(&quot;No patients available in waitingPatients&quot;)
    return
}

// Get global used UIN list from props (stored as comma-separated string)
def usedUinString = props.get(&quot;USED_UIN_SET&quot;) ?: &quot;&quot;
def usedSet = new HashSet(usedUinString.tokenize(&quot;,&quot;))

def slurper = new JsonSlurper()
boolean found = false

for (int i = 1; i &lt;= count; i++) {

    String patientJson = vars.get(&quot;patientData_&quot; + i)
    def patientObj = slurper.parseText(patientJson)

    String uin = patientObj.uin

    if (uin &amp;&amp; !usedSet.contains(uin)) {

        vars.put(&quot;uin&quot;, uin)
        vars.put(&quot;mrNo&quot;, patientObj.mrNo)
        vars.put(&quot;pin&quot;, patientObj.pin)
        vars.put(&quot;oid&quot;, patientObj.oid)
        vars.put(&quot;firstName&quot;, patientObj.firstName)

        usedSet.add(uin)

        // Save back as comma-separated string
        props.put(&quot;USED_UIN_SET&quot;, usedSet.join(&quot;,&quot;))

        log.info(&quot;Selected Unique Patient UIN: &quot; + uin)
        found = true
        break
    }
}

if (!found) {
    log.warn(&quot;All patients already used. No new patient available.&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
