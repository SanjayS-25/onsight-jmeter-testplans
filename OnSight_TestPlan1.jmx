                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ConcurrentHashMap

int count = (vars.get(&quot;patientData_matchNr&quot;) ?: &quot;0&quot;) as int

if (count == 0) {
    log.warn(&quot;No patients available in waitingPatients&quot;)
    return
}

// Get global used UIN list from props (stored as comma-separated string)
def usedUinString = props.get(&quot;USED_UIN_SET&quot;) ?: &quot;&quot;
def usedSet = new HashSet(usedUinString.tokenize(&quot;,&quot;))

def slurper = new JsonSlurper()
boolean found = false

for (int i = 1; i &lt;= count; i++) {

    String patientJson = vars.get(&quot;patientData_&quot; + i)
    def patientObj = slurper.parseText(patientJson)

    String uin = patientObj.uin

    if (uin &amp;&amp; !usedSet.contains(uin)) {

        vars.put(&quot;uin&quot;, uin)
        vars.put(&quot;mrNo&quot;, patientObj.mrNo)
        vars.put(&quot;pin&quot;, patientObj.pin)
        vars.put(&quot;oid&quot;, patientObj.oid)
        vars.put(&quot;firstName&quot;, patientObj.firstName)

        usedSet.add(uin)

        // Save back as comma-separated string
        props.put(&quot;USED_UIN_SET&quot;, usedSet.join(&quot;,&quot;))

        log.info(&quot;Selected Unique Patient UIN: &quot; + uin)
        found = true
        break
    }
}

if (!found) {
    log.warn(&quot;All patients already used. No new patient available.&quot;)
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ConcurrentHashMap

int count = (vars.get(&quot;patientData_matchNr&quot;) ?: &quot;0&quot;) as int
if (count == 0) {
    log.warn(&quot;No waiting patients found&quot;)
    return
}

// Identify current Thread Group
def tgName = ctx.getThreadGroup().getName()

// Create unique pool per TG
def propKey = &quot;PATIENT_POOL_&quot; + tgName

def pool = props.get(propKey)

if (pool == null) {
    synchronized(this) {
        pool = props.get(propKey)
        if (pool == null) {
            pool = new ConcurrentHashMap()
            props.put(propKey, pool)
        }
    }
}

def slurper = new JsonSlurper()
boolean selected = false

for (int i = 1; i &lt;= count; i++) {

    def patientJson = vars.get(&quot;patientData_&quot; + i)
    if (!patientJson) continue

    def obj = slurper.parseText(patientJson)

    def uin = obj?.uin
    def firstName = obj?.firstName

    // Filter only PATIENT-PT*
    if (!uin || !firstName?.startsWith(&quot;PATIENT-PT&quot;))
        continue

    // Atomic check
    if (pool.putIfAbsent(uin, true) == null) {

        vars.put(&quot;uin&quot;, uin)
        vars.put(&quot;mrNo&quot;, obj?.mrNo ?: &quot;&quot;)
        vars.put(&quot;pin&quot;, obj?.pin ?: &quot;&quot;)
        vars.put(&quot;oid&quot;, obj?.oid ?: &quot;&quot;)
        vars.put(&quot;firstName&quot;, firstName)

        log.info(&quot;TG: &quot; + tgName + &quot; Selected UIN: &quot; + uin)

        selected = true
        break
    }
}

if (!selected) {
    log.warn(&quot;TG: &quot; + tgName + &quot; No unused PATIENT-PT available&quot;)
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ConcurrentHashMap

int count = (vars.get(&quot;patientData_matchNr&quot;) ?: &quot;0&quot;) as int
if (count == 0) {
    log.warn(&quot;No waiting patients found&quot;)
    vars.put(&quot;skipFlow&quot;, &quot;true&quot;)
    return
}

// ── Global claim map ──────────────────────────────────────────────
// Key:   &quot;uin::tgName&quot;
// Value: &quot;done&quot;
// Means: this patient has been processed by this TG already
def claimKey = &quot;GLOBAL_PATIENT_CLAIM_MAP&quot;
if (props.get(claimKey) == null) {
    synchronized (this) {
        if (props.get(claimKey) == null) {
            props.put(claimKey, new ConcurrentHashMap())
        }
    }
}
ConcurrentHashMap claimMap = props.get(claimKey)

def tgName  = ctx.getThreadGroup().getName()
def slurper = new JsonSlurper()

// ── Collect ALL valid PATIENT-PT* patients ────────────────────────
// Identified by UIN (unique) — name may be duplicate
def validPatients = []
def seenUINs      = new HashSet&lt;String&gt;()   // deduplicate by UIN

for (int i = 1; i &lt;= count; i++) {
    def patientJson = vars.get(&quot;patientData_&quot; + i)
    if (!patientJson) continue

    def obj
    try {
        obj = slurper.parseText(patientJson)
    } catch (Exception e) {
        log.warn(&quot;Parse error patientData_${i}: ${e.message}&quot;)
        continue
    }

    def uin       = obj?.uin?.toString()?.trim()
    def firstName = obj?.firstName?.toString()?.trim()

    // Must be a test patient
    if (!uin || !firstName?.startsWith(&quot;PATIENT-PT&quot;)) {
        log.info(&quot;Skipped (not test patient): ${firstName} | UIN: ${uin}&quot;)
        continue
    }

    // Deduplicate by UIN — name may be same but UIN is unique
    if (seenUINs.contains(uin)) {
        log.info(&quot;Skipped duplicate UIN: ${uin}&quot;)
        continue
    }

    seenUINs.add(uin)
    validPatients &lt;&lt; obj
}

if (validPatients.isEmpty()) {
    log.warn(&quot;⛔ No valid PATIENT-PT* patients found&quot;)
    vars.put(&quot;skipFlow&quot;, &quot;true&quot;)
    return
}

log.info(&quot;═══════════════════════════════════════════════════&quot;)
log.info(&quot;TG [${tgName}] | Total valid patients: ${validPatients.size()}&quot;)

// Log all patients in pool
validPatients.each { p -&gt;
    def u  = p?.uin?.toString()?.trim()
    def fn = p?.firstName?.toString()?.trim()
    def ck = &quot;${u}::${tgName}&quot;
    def status = claimMap.containsKey(ck) ? &quot;❌ USED&quot; : &quot;✅ AVAILABLE&quot;
    log.info(&quot;  ${status} | UIN: ${u} | Name: ${fn}&quot;)
}
log.info(&quot;═══════════════════════════════════════════════════&quot;)

// ── Pick first patient NOT yet used by THIS TG ────────────────────
// Uses UIN as unique identifier — not name
boolean selected = false

for (def obj : validPatients) {
    def uin          = obj?.uin?.toString()?.trim()
    def firstName    = obj?.firstName?.toString()?.trim()

    // Unique key per patient per TG
    def compositeKey = &quot;${uin}::${tgName}&quot;

    if (claimMap.putIfAbsent(compositeKey, &quot;done&quot;) == null) {
        // ── Successfully claimed ──────────────────────────────────
        vars.put(&quot;uin&quot;,                    uin)
        vars.put(&quot;mrNo&quot;,                   obj?.mrNo                   ?: &quot;&quot;)
        vars.put(&quot;pin&quot;,                    obj?.pin                    ?: &quot;&quot;)
        vars.put(&quot;oid&quot;,                    obj?.oid                    ?: &quot;&quot;)
        vars.put(&quot;firstName&quot;,              firstName)
        vars.put(&quot;patientWorkFlowOrderId&quot;, obj?.patientWorkFlowOrderId ?: &quot;&quot;)
        vars.put(&quot;skipFlow&quot;,               &quot;false&quot;)

        // ── Log claim summary ─────────────────────────────────────
        def totalUsedByTG = claimMap.keySet()
                                    .findAll { it.endsWith(&quot;::${tgName}&quot;) }
                                    .size()
        log.info(&quot;✅ TG [${tgName}] → Picked UIN: ${uin} | Name: ${firstName}&quot;)
        log.info(&quot;   This TG has now used ${totalUsedByTG}/${validPatients.size()} patients&quot;)

        selected = true
        break

    } else {
        log.info(&quot;↩ TG [${tgName}] already processed UIN: ${uin} — trying next&quot;)
    }
}

// ── All patients exhausted for this TG ───────────────────────────
if (!selected) {
    def usedCount = claimMap.keySet()
                            .findAll { it.endsWith(&quot;::${tgName}&quot;) }
                            .size()
    log.warn(&quot;⛔ TG [${tgName}] — All ${usedCount}/${validPatients.size()} patients already used&quot;)
    vars.put(&quot;skipFlow&quot;, &quot;true&quot;)
}</stringProp>
