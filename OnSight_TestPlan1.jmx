              <stringProp name="filename"></stringProp>
              <stringProp name="script">var vtime1;
var vtime2;
var s1;

var pv1;
var pv2;
var pc1
 
vtime1 = props.get(&quot;time_start&quot;);
pv1 = parseInt(vtime1);

s1 = vars.get(&quot;timecnt&quot;);
pc1 = parseInt(s1);

vtime2 = ${__time(,)};
pv2 = parseInt(vtime2);

pv1 = pv1 + pc1; 

if (pv2 &gt; pv1)
 {
  vars.put(&quot;timevar1&quot;,&quot;false&quot;);
 } </stringProp>
            </BSFSampler>
